{
  "name": "kitlab/commerce",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-bcmath": "*",
    "ext-pdo_mysql": "*",
    "laravel/framework": "^12.0",
    "maatwebsite/excel": "^3.1",
    "picqer/php-barcode-generator": "^3.2",
    "bacon/bacon-qr-code": "^3.0"
  },
  "require-dev": {"phpunit/phpunit": "^11.5", "fakerphp/faker": "^1.23"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Seeders\\": "database/seeders/", "Database\\Factories\\": "database/factories/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {"post-autoload-dump": ["@php artisan package:discover --ansi"]},
  "config": {"sort-packages": true}
}
